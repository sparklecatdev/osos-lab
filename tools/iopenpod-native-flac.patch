+def test_repriseos_sync_preserves_flac_bytes(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    ffmpeg = shutil.which("ffmpeg")
+    if ffmpeg is None or shutil.which("ffprobe") is None:
+        pytest.skip("Actual media preparation needs FFmpeg and FFprobe")
+    classic = next(p for p in DEFAULT_CATALOG.profiles if p.family == "iPod Classic")
+    path = tmp_path / "tone.flac"
+    subprocess.run(
+        [ffmpeg, "-v", "error", "-f", "lavfi", "-i", "sine=duration=0.1", str(path)],
+        check=True,
+    )
+    monkeypatch.setenv("REPRISEOS_NATIVE_FLAC", "1")
+    with MediaTranscoder().prepare(
+        HostPath(path), classic, TranscodeSettings(), checkpoint=lambda: None
+    ) as result:
+        assert result.encoding is AudioEncoding.FLAC
+        assert not result.was_transcoded
+        assert Path(result.source).read_bytes() == path.read_bytes()
+        extension, _ = audio_file_details(result.encoding, MediaKind.MUSIC)
+        location = MusicPathAllocator(1).allocate(extension)
+        assert location.endswith(".flac")
+        fingerprint = result.inspection.fingerprint
+        media = prepared_audio(
+            0,
+            FileDependency(location, fingerprint.size, fingerprint.sha256),
+            result.encoding,
+        )
+        assert media.filetype == int.from_bytes(b"WAV ", "big")
+
