+def test_repriseos_sync_writes_flac_playback_metadata(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    ffmpeg = shutil.which("ffmpeg")
+    if ffmpeg is None or shutil.which("ffprobe") is None:
+        pytest.skip("Actual media preparation needs FFmpeg and FFprobe")
+    monkeypatch.setenv("REPRISEOS_NATIVE_FLAC", "1")
+    source_directory = tmp_path / "source"
+    source_directory.mkdir()
+    tracks = {
+        "First": (4411, "-7.25 dB", -7.25),
+        "Second": (8821, "invalid", -4.6),
+    }
+    for title, (samples, track_gain, _) in tracks.items():
+        subprocess.run(
+            [
+                ffmpeg,
+                "-v",
+                "error",
+                "-f",
+                "lavfi",
+                "-i",
+                "sine=duration=0.3",
+                "-af",
+                f"atrim=end_sample={samples}",
+                "-metadata",
+                f"title={title}",
+                "-metadata",
+                f"REPLAYGAIN_TRACK_GAIN={track_gain}",
+                "-metadata",
+                "REPLAYGAIN_ALBUM_GAIN=-4.6 dB",
+                "-metadata",
+                "ITUNESGAPLESS=1",
+                str(source_directory / f"{title}.flac"),
+            ],
+            check=True,
+        )
+    scanner = HostMediaScanner()
+    pending = scanner.scan(
+        (create_host_media_folder(source_directory),), checkpoint=lambda: None
+    )
+    host = scanner.complete(pending, frozenset(), checkpoint=lambda: None)
+    device = build_device(tmp_path)
+    try:
+        request = _request(device, host)
+        request = replace(
+            request,
+            plan=select_sync_plan(
+                request.plan,
+                selected_host_paths=frozenset(
+                    host_path_identity(str(source.path)) for source in host.sources
+                ),
+                selected_ipod_removals=frozenset(),
+            ),
+        )
+        result = SyncExecutor(device.coordinator).execute(
+            request, lambda _: None, Event()
+        )
+        assert result.status is SyncExecutionStatus.SUCCESS, result.issues
+        database = device.root / "iPod_Control/iTunes/iTunesDB"
+        synced = {
+            track.title: track.metadata
+            for track in IPodLibrary.parse(database.read_bytes()).snapshot.tracks
+            if track.title in tracks
+        }
+        assert synced.keys() == tracks.keys()
+        for title, (samples, _, gain) in tracks.items():
+            meta = synced[title]
+            assert meta.sample_count == samples
+            assert meta.pregap == meta.postgap == 0
+            assert meta.gapless and meta.gapless_album
+            assert meta.normalization_gain_db == pytest.approx(gain, abs=0.01)
+            path = device.root / meta.location
+            assert path.suffix == ".flac"
+            assert (
+                path.read_bytes() == (source_directory / f"{title}.flac").read_bytes()
+            )
+    finally:
+        device.coordinator.close()
+
