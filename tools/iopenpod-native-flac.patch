+def _repriseos_flac_plan(stream: BinaryIO) -> TranscodePlan | None:
+    if stream.read(8) not in (b"fLaC\x00\x00\x00\x22", b"fLaC\x80\x00\x00\x22"):
+        return None
+    stream.seek(0)
+    try:
+        info = FLAC(stream).info
+    except mutagen.MutagenError:
+        return None
+    if (
+        not 8000 <= info.sample_rate <= 48000
+        or not 1 <= info.channels <= 2
+        or not 4 <= info.bits_per_sample <= 24
+        or not 16 <= info.min_blocksize <= info.max_blocksize <= 4608
+        or not 0 < info.total_samples * info.channels * 2 <= 0x7FFFFFFF - 44
+    ):
+        return None
+    return TranscodePlan(
+        AudioEncoding.FLAC,
+        ".flac",
+        (),
+        info.sample_rate,
+        info.channels,
+        copies_audio=True,
+    )
