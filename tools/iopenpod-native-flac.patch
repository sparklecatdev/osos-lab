+def _repriseos_flac_plan(stream: BinaryIO) -> TranscodePlan | None:
+    if stream.read(8) not in (b"fLaC\x00\x00\x00\x22", b"fLaC\x80\x00\x00\x22"):
+        return None
+    stream.seek(0)
+    try:
+        flac = cast("Callable[[BinaryIO], FLAC]", FLAC)(stream)
+    except mutagen.MutagenError:
+        return None
+    info = flac.info
+    if (
+        not 8000 <= info.sample_rate <= 48000
+        or not 1 <= info.channels <= 2
+        or not 4 <= info.bits_per_sample <= 24
+        or not 16 <= info.min_blocksize <= info.max_blocksize <= 4608
+        or not 0 < info.total_samples * info.channels * 2 <= 0x7FFFFFFF - 44
+    ):
+        return None
+    tags = cast("Mapping[str, list[str]]", flac.tags or {})
+    gain = next(
+        (
+            value
+            for key in ("replaygain_track_gain", "replaygain_album_gain")
+            for raw in tags.get(key, [])
+            if (value := replaygain_db(raw.strip())) is not None
+        ),
+        None,
+    )
+    return TranscodePlan(
+        AudioEncoding.FLAC,
+        ".flac",
+        (),
+        info.sample_rate,
+        info.channels,
+        copies_audio=True,
+        native_flac_samples=info.total_samples,
+        replaygain_db=gain,
+    )
+
+
